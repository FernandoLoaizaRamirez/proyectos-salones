{
  "name": "proyectos-salones",
  "version": "0.1.0",
  "private": true,
  "description": "Suite modular de aplicaciones para salones de eventos.",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint //#lint:raiz",
    "lint:raiz": "eslint tests vitest.config.ts",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\""
  },
  "devDependencies": {
    "@salones/config": "workspace:*",
    "@salones/directorio": "workspace:*",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
